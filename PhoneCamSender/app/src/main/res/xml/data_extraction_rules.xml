<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The token is encrypted with a device-bound Android Keystore key. -->
        <exclude domain="sharedpref" path="phonecam_secure.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Do not migrate ciphertext without the originating device's Keystore key. -->
        <exclude domain="sharedpref" path="phonecam_secure.xml"/>
    </device-transfer>
</data-extraction-rules>